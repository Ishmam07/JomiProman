# Copy to .env  (cp .env.example .env). Never commit the real .env.
# Keep passwords to letters, digits, "_" and "-" (they are placed inside a database URL).

# ---- MySQL (used by docker compose) ----
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=jomiproman
MYSQL_USER=jomi
MYSQL_PASSWORD=jomi_pass

# ---- App ----
ENVIRONMENT=development
REGISTRAR_KEY=demo-registrar
PUBLIC_BASE_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100,http://localhost:5173
AUTO_SEED=true

# ---- AI (Groq) ----
# Get a key at https://console.groq.com . Leave empty to run with the built-in fallbacks.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Ports on your machine ----
WEB_PORT=3100
API_PORT=8101
MYSQL_PORT=13306
REDIS_PORT=16379

# ---- Only for running the backend OUTSIDE Docker (e.g. from IntelliJ) ----
# `docker compose up -d mysql redis` first, then these point the local backend at those containers.
# (docker compose ignores these two lines; it builds its own URLs.)
DATABASE_URL=mysql+pymysql://jomi:jomi_pass@localhost:13306/jomiproman?charset=utf8mb4
REDIS_URL=redis://localhost:16379/0
